{
  "version": 161,
  "rendererVersion": "employee_sdui_v161_flat_profile_settings_overflow_safe",
  "screenOverrides": {
    "profile": {
      "screen": "profile",
      "type": "profileSummary",
      "title": "Profile",
      "subtitle": "Private employee workspace profile",
      "variant": "premiumWorkspaceProfile",
      "hideTitle": false,
      "settingsSectionEnabled": true,
      "settingsExpandable": true,
      "settingsTitle": "Settings",
      "settingsPlacement": "afterProfileActionsBeforeProfileInfo",
      "notificationSettingsPlacement": "insideSettingsAccordion",
      "hideStandaloneNotificationSettings": true,
      "hideLogoutPreview": true,
      "logoutPlacement": "profileActionButton",
      "logoutStyle": "filledIcon",
      "actionButtonColorMode": "sameAppAccent",
      "layoutOrder": [
        "profileHeader",
        "onlineStatus",
        "availability",
        "profileActionButtons",
        "settingsAccordion",
        "assignedScope",
        "role",
        "company"
      ],
      "sections": [
        {
          "type": "profileHeroCard",
          "id": "profileHeader",
          "title": "Profile header"
        },
        {
          "type": "onlineStatusCard",
          "id": "onlineStatus",
          "title": "Online status"
        },
        {
          "type": "profileToggleRow",
          "id": "availability",
          "title": "Availability"
        },
        {
          "type": "profileActionList",
          "id": "profileActionButtons",
          "layout": "twoColumn",
          "buttonColorMode": "sameAppAccent",
          "showLogoutPreview": false,
          "items": [
            {
              "type": "profileAction",
              "action": "editProfile",
              "label": "Edit profile",
              "icon": "edit",
              "style": "accentSoftFilled"
            },
            {
              "type": "profileAction",
              "action": "copyLog",
              "label": "Copy log",
              "icon": "receipt_long",
              "style": "accentSoftOutlined"
            },
            {
              "type": "profileAction",
              "action": "crashlyticsTest",
              "label": "Crashlytics Test",
              "icon": "bug_report",
              "style": "accentSoftOutlined"
            },
            {
              "type": "profileAction",
              "action": "logout",
              "label": "Logout",
              "icon": "logout",
              "style": "accentSoftFilled"
            }
          ]
        },
        {
          "type": "settingsList",
          "id": "settingsAccordion",
          "title": "Settings",
          "collapsed": true,
          "expandedDefault": false,
          "expandBehavior": "tapToExpandCollapse",
          "hideLogoutPreview": true,
          "items": [
            {
              "type": "notificationAlert",
              "id": "notificationAlertSettings",
              "title": "Notification alert settings",
              "showEnableNotifications": true,
              "showSoundSelector": true,
              "showAssistantVoiceToggle": true,
              "showDisplayWindowSelector": true,
              "showSaveWindowButton": true,
              "showTestButton": true,
              "showLogoutPreview": false
            }
          ]
        },
        {
          "type": "profileInfoSection",
          "id": "assignedScope",
          "title": "Assigned scope",
          "fields": [
            "projects",
            "tasks",
            "teams",
            "access"
          ]
        },
        {
          "type": "profileInfoSection",
          "id": "role",
          "title": "Role",
          "fields": [
            "role",
            "department",
            "jobTitle"
          ]
        },
        {
          "type": "profileInfoSection",
          "id": "company",
          "title": "Company",
          "fields": [
            "companyName",
            "location",
            "joinedAt"
          ]
        }
      ],
      "version": 161,
      "rendererMode": "dedicatedProfileBeforeGenericSections",
      "settingsContentStyle": "flatNoInnerCard",
      "compactOverflowProtection": true
    }
  },
  "notes": [
    "Notification alert settings render flat inside the Settings accordion; no nested inner card.",
    "Compact overflow protection is enabled for alert rows, tags, dropdowns, and action buttons.",
    "Profile action buttons remain outside Settings and Logout preview stays hidden."
  ]
}